{
	"compilerOptions": {
		// Enable latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"allowJs": true,

		"types": [
			"vitest/globals",
			"@girs/gjs",
			"@girs/gtk-4.0",
			"@girs/gio-2.0",
			"@girs/glib-2.0"
		],
		// JSX
		"jsx": "react-jsx",
		"jsxImportSource": "@lib/jsx",

		// Build
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,

		// Aliases
		"baseUrl": ".",
		"paths": {
			"@lib": ["./lib/"],
			"@lib/*": ["./lib/*"]
		},

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"include": ["lib", "test"],
	"exclude": ["node_modules", "dist"]
}
